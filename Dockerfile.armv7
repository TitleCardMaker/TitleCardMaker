# syntax=docker/dockerfile:1.4
FROM python:3.13-slim AS builder

# Copy dependency files first for better layer caching
COPY backend/pyproject.toml backend/pyproject.lock* ./

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc && \
    pip install --no-cache-dir --upgrade setuptools uv && \
    uv pip compile pyproject.toml --output-file requirements.txt

# Generate requirements.txt and install dependencies
RUN --mount=type=cache,target=/root/.cache \
    pip3 install --no-cache-dir -r requirements.txt

# Stage 2: Runtime image
FROM python:3.13-slim AS runtime

# Add metadata
LABEL maintainer="CollinHeist" \
    description="Automated Title Card creator for Plex, Emby, and Jellyfin" \
    org.opencontainers.image.title="TitleCardMaker" \
    org.opencontainers.image.description="Automated Title Card creator for Plex, Emby, and Jellyfin"

# Copy python packages from builder stage
COPY --from=builder \
    /usr/local/lib/python3.13/site-packages \
    /usr/local/lib/python3.13/site-packages

# Set working directory
WORKDIR /tcm
COPY . /tcm

# Install runtime dependencies
RUN \
    # Create non-root user
    set -eux && \
    groupadd -g 314 titlecardmaker && \
    useradd -u 314 -g 314 -m -s /bin/bash titlecardmaker && \
    # Install imagemagick curl (for healthcheck), and pillow dependencies
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl imagemagick libmagickcore-6.q16-6-extra
        libwebpmux3 liblcms2-2 libwebpdemux2 libopenjp2-7 && \
    cp backend/assets/policy.xml /etc/ImageMagick-6/policy.xml && \
    # Remove apt cache and setup files
    rm -rf pyproject.toml /tmp/* /var/tmp/* /var/lib/apt/lists/* 

# Copy Python packages from builder stage
COPY --from=builder \
    /usr/local/lib/python3.13/site-packages \
    /usr/local/lib/python3.13/site-packages

# Expose port
EXPOSE 4242

# Environment variables
ARG TCM_IS_DEVELOP=FALSE
ENV TCM_IS_DOCKER=TRUE \
    TCM_IS_DEVELOP=${TCM_IS_DEVELOP} \
    TZ=UTC

# Healthcheck command
# Add --start-interval=10s back in when merged in Docker v24/v25
HEALTHCHECK --interval=3m --timeout=10s --start-period=3m \
    CMD curl --fail http://0.0.0.0:4242/api/healthcheck || exit 1

# Entrypoint and command - run as root to allow start.sh to modify user/group
WORKDIR /tcm/backend
CMD ["python3", "-u", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "4242"]
ENTRYPOINT ["bash", "./start.sh"]
